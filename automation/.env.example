# Toutes les valeurs à renseigner avant de démarrer.
# Copie ce fichier en .env et complète chaque ligne.
# Ce fichier est à titre documentaire : les valeurs réelles
# se configurent dans n8n Cloud → Variables (jamais en clair ici).

# ─── Supabase ───────────────────────────────────────────────
# URL de ton projet (ex. https://xxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# Clé service_role (Supabase → Project Settings → API → service_role key)
# ⚠️ CONFIDENTIELLE — ne partage jamais cette clé
SUPABASE_SERVICE_ROLE_KEY=

# ─── PDFShift (conversion HTML → PDF) ──────────────────────
# Compte : https://pdfshift.io
# Clé disponible dans Dashboard → API Keys
PDFSHIFT_API_KEY=

# Mettre à "true" pour tester sans consommer de crédits PDFShift
# (PDF en filigrane). Mettre à "false" ou laisser vide en production.
PDFSHIFT_SANDBOX=false

# ─── Supabase Storage — liens signés ──────────────────────
# Durée de validité des liens de téléchargement, en secondes.
# Par défaut : 604800 (7 jours)
SIGNED_URL_TTL_SECONDS=604800

# ─── Validation des carnets (workflow A/A2) ────────────────
# Token secret pour protéger le webhook de validation A2.
# Génère un token aléatoire : openssl rand -hex 32
CARNET_VALIDATION_TOKEN=

# URL de base de ton instance n8n Cloud (sans slash final)
# Exemple : https://monequipe.app.n8n.cloud
CASE_DEPART_WEBHOOK_BASE=

# URL de revalidation de ton site (Next.js on-demand revalidation).
# Optionnel — laisser vide si non utilisé.
# Exemple : https://casedepart.fr/api/revalidate?secret=MON_SECRET
SITE_REVALIDATE_URL=

# ─── Notifications internes (workflow A + B) ──────────────
# URL d'un webhook générique (Slack, Telegram, Discord…)
# Optionnel — laisser vide pour désactiver les notifications.
# Exemple Slack : https://hooks.slack.com/services/XXX/YYY/ZZZ
NOTIFY_WEBHOOK_URL=

# ─── Stripe (workflow B) ──────────────────────────────────
# Clé secrète Stripe (Dashboard → Développeurs → Clés API)
# Utiliser sk_test_... en mode test, sk_live_... en production
STRIPE_SECRET_KEY=

# Secret de signature du webhook Stripe (optionnel mais recommandé)
# Dashboard Stripe → Webhooks → Ton webhook → Signing secret
STRIPE_WEBHOOK_SECRET=

# ─── Fournisseur d'e-mail (workflows B + C) ───────────────
# Adresse d'envoi (ex. contact@casedepart.fr)
EMAIL_FROM=

# URL de l'API de ton fournisseur e-mail
# Brevo    : https://api.brevo.com/v3/smtp/email
# Resend   : https://api.resend.com/emails
# MailerLite: https://connect.mailerlite.com/api/subscribers
# Adapte aussi le corps de la requête dans le nœud e-mail (voir README).
EMAIL_PROVIDER_URL=

# Clé API de ton fournisseur e-mail
EMAIL_PROVIDER_API_KEY=

# Afficher l'e-mail de l'acheteur en pied de page des PDF (traçabilité)
# "true" pour activer, "false" (défaut) pour désactiver
BUYER_EMAIL_IN_FOOTER=false

